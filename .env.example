# Keep this beside serve.mjs, never inside dist.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_MAX_TOKENS=32768
AI_TIMEOUT_SECONDS=900
OPENAI_REASONING_EFFORT=medium

# To use Grok instead, set AI_PROVIDER=xai and configure these.
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# XAI_REASONING_EFFORT=low

# Claude can also be selected per conversation in the workspace. Keep the OpenAI key.
# To make Claude the default, set AI_PROVIDER=anthropic and configure these.
# Provider keys are separate; a key is never forwarded to another provider.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_WORKSPACE_ID=


# Name.com sandbox search and one-year pricing (purchases are not connected).
# Use your Name.com username with -test appended and a Development/Test token.
# Keep the OpenAI key above unchanged; do not paste tokens in chat.
NAMECOM_ENVIRONMENT=sandbox
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=

# Provisional sandbox service markup, applied separately to registration and renewal.
# Retail = provider price + max(provider price * percent / 100, minimum fee).
# Minimum is in US cents. Both settings may be 0. Restart is not needed after saving.
DOMAIN_MARKUP_PERCENT=20
DOMAIN_MIN_FEE_CENTS=500

# Django accounts: npm run setup:accounts generates a private signing key.
DJANGO_SECRET_KEY=
DJANGO_APP_ORIGIN=http://127.0.0.1:4175
DJANGO_REQUIRE_EMAIL_VERIFICATION=0
# Without SMTP, reset/verification messages are saved in data/development-mail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_FROM=Draftmango <noreply@localhost>

# Stripe subscriptions. Begin with test keys and test prices from the same account.
# Never put secret keys in dist or in chat. Restart npm run dev after changing these.
BILLING_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Scope customer billing management to Draftmango's portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Enable only after Stripe Tax is configured for your business.
STRIPE_AUTOMATIC_TAX=0

# Publishing HTTPS provisioning only; never exposed to browsers or the web container.
# Cloudflare token: Zone DNS Edit + Zone Read, restricted to draftmango.com.
CLOUDFLARE_DNS_API_TOKEN=
