# Draftmango HTTPS; certificate renewal managed by draftmango-certificate.timer.
server {
    listen 80;
    listen [::]:80;
    server_name draftmango.com www.draftmango.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 308 https://draftmango.com$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.draftmango.com;
    ssl_certificate /etc/letsencrypt/draftmango-managed/live/draftmango.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/draftmango-managed/live/draftmango.com/privkey.pem;
    return 308 https://draftmango.com$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name draftmango.com;
    ssl_certificate /etc/letsencrypt/draftmango-managed/live/draftmango.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/draftmango-managed/live/draftmango.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 9m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Strict-Transport-Security "max-age=86400" always;
    resolver 127.0.0.11 valid=10s;
    location / {
        set $draftmango_upstream draftmango-web:4175;
        proxy_pass http://$draftmango_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host draftmango.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1900s;
        proxy_send_timeout 60s;
        # Suppress query strings and account paths in the shared proxy access log.
        access_log off;
    }
}
